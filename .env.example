# --------- Language ---------
# Persona / prompts / toast / card-action strings come in two language packs.
# zh = load core/persona_zh.py + core/prompts_zh.py (default)
# en = load core/persona_en.py + core/prompts_en.py
ELENA_LANGUAGE=zh

# --------- LLM ---------
# Any OpenAI-compatible endpoint will work. Set base URL + model accordingly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45

# --------- Feishu self-built app (required for cards + callbacks) ---------
# Created at https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Target chat. Get this by running:
#   python scripts/get_chat_id.py
# then sending any message to your bot in Feishu.
FEISHU_DAILY_CHAT_ID=

# Card template IDs + versions. Fill in after importing the four .card files
# under feishu_cards/ into your own Feishu card builder.
FEISHU_TEMPLATE_DAILY_SUMMARY_ID=
FEISHU_TEMPLATE_DAILY_SUMMARY_VERSION=
FEISHU_TEMPLATE_ARXIV_PAPER_ID=
FEISHU_TEMPLATE_ARXIV_PAPER_VERSION=
FEISHU_TEMPLATE_HF_PAPERS_ID=
FEISHU_TEMPLATE_HF_PAPERS_VERSION=
FEISHU_TEMPLATE_GH_TRENDING_ID=
FEISHU_TEMPLATE_GH_TRENDING_VERSION=

# --------- Optional: plain-text webhook fallback ---------
# If the self-built app credentials above are missing, run_daily falls back
# to this classic incoming webhook with a signed text message.
FEISHU_BOT_WEBHOOK=
FEISHU_BOT_SECRET=
FEISHU_BOT_KEYWORD=elena

# --------- Optional: PDF ---------
# Hugging Face mirror used when MinerU downloads weights.
HF_ENDPOINT=https://hf-mirror.com
MINERU_TIMEOUT_SECONDS=900
# Pin a specific GPU for MinerU; leave empty to use the default.
MINERU_CUDA_VISIBLE_DEVICES=

# --------- Server ---------
# Daily push trigger time, UTC (HH:MM). 02:30 UTC = 10:30 UTC+8.
DAILY_SCHEDULE_UTC=02:30
SERVER_POLL_SECONDS=30

# Where Elena writes runtime state. Defaults to ./data inside the project.
# ELENA_DATA_DIR=

# --------- HTTP retry knobs (rarely changed) ---------
HTTP_RETRY_ATTEMPTS=4
HTTP_RETRY_MIN_WAIT_SECONDS=2
HTTP_RETRY_MAX_WAIT_SECONDS=20
